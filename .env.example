# Contact form (https://resend.com, free tier). Without these the form shows a friendly "not configured" message.
RESEND_API_KEY=
CONTACT_TO_EMAIL=you@example.com
# Optional once you verify a domain in Resend:
# CONTACT_FROM_EMAIL=Portfolio <contact@yourdomain.com>
# After deploying:
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
